{
  "manifest_version": 3,
  "name": "一键全屏",
  "version": "1.4",
  "description": "Alt+Shift+F 页面全屏（瞬切），Alt+Shift+G 窗口全屏（跨页面保持），Esc 退出。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "全屏 / 退出全屏",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-fullscreen.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
